# Copie este arquivo para ".env" (cp .env.example .env) e preencha com os seus
# dados LOCAIS. O arquivo ".env" NUNCA deve ir para o Git (já está no .gitignore).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=seu_usuario_local
DB_PASSWORD=coloque_sua_senha_local
DB_DATABASE=bookworms
PORT=3000
# Origem do frontend liberada no CORS (padrão: endereço do Vite)
CORS_ORIGIN=http://localhost:5173
